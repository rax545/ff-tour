# Copy to .env locally. Never commit real tokens or credentials.
DISCORD_TOKEN=
# Required for a real deployment: the database is shared, NOT multi-tenant.
GUILD_ID=0
ADMIN_ROLE_ID=0
MANAGER_ROLE_ID=0
SERVER_NAME=Root LU
BRAND=Root LU
DATABASE_PATH=data/esports.sqlite3
TIMEZONE_UTC_OFFSET=+06:00
PORT=10000

# Review-only radar thresholds. These NEVER cause automatic bans.
RADAR_NEW_ACCOUNT_DAYS=7
RADAR_MIN_MATCHES=3
RADAR_KILLS_PER_MATCH=12
